---
layout: base.njk
title: Kontakt und Anfrage
description: Projekt anfragen oder Frage zu einem laufenden Auftrag stellen – Antwort innerhalb von 24 Stunden.
permalink: /kontakt/
scripts: ["/assets/js/anfrage.js"]
---
<div class="light">
<div class="wrap form-page">

  <aside class="form-aside">
    <h1 class="h-display">Jetzt loslegen<span class="brand">.</span></h1>
    <p class="lead">Ob neues Projekt oder Frage zu einem laufenden Auftrag: ein Formular, Antwort {{ site.antwortzeit }}.</p>
    <div aria-hidden="true" style="height: 110px; width: 84px; background: var(--magenta-500); transform: skewX(-13deg); margin: 4px 0 4px 24px"></div>
    <dl style="margin: 0; display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--navy-900); padding-top: 14px">
      <div><dt class="eyebrow plain" style="color: var(--navy-900)">Lieber direkt?</dt>
        <dd style="margin: 0; display: flex; flex-wrap: wrap; gap: 0 20px; font-size: 15px; font-weight: 700"><a class="tap" href="tel:{{ site.telefon_link }}">{{ site.telefon }}</a><a class="tap" href="mailto:{{ site.email }}">{{ site.email }}</a></dd></div>
      <div><dt class="eyebrow plain" style="color: var(--navy-900)">Adresse</dt><dd class="small muted" style="margin: 4px 0 0">{{ site.strasse }} · {{ site.ort }}</dd></div>
    </dl>
    <p class="hint">Ich nutze Ihre Angaben nur, um Ihre Anfrage zu beantworten. Keine Weitergabe, kein Newsletter. Mehr in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
  </aside>

  <div class="form-card">
    <ol class="progress" aria-label="Fortschritt">
      <li class="done" data-step="1">Kundentyp</li>
      <li data-step="2">Angaben</li>
      <li data-step="3">Gesendet</li>
    </ol>

    <div class="thanks" id="danke" role="status" tabindex="-1" hidden>
      <div class="thanks-icon" aria-hidden="true">✓</div>
      <h2 style="font-size: 34px; line-height: 40px">Danke, <span data-out="vorname"></span><span class="brand">.</span></h2>
      <p class="lead" data-out="danketext"></p>
      <dl class="meta" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr))">
        <div><dt>Anliegen</dt><dd data-out="anliegen"></dd></div>
        <div><dt>Antwort an</dt><dd data-out="email" style="overflow-wrap: anywhere"></dd></div>
        <div><dt>Antwort</dt><dd>Innerhalb von 24 Stunden</dd></div>
      </dl>
      <div class="thanks-actions">
        <button type="button" class="text-btn" data-edit>Angaben bearbeiten</button>
        <button type="button" class="text-btn quiet" data-reset>Neue Anfrage</button>
      </div>
    </div>

    <form id="anfrage" action="{{ site.anfrage_endpunkt }}" method="post" novalidate data-endpoint="{{ site.anfrage_endpunkt }}" style="display: flex; flex-direction: column; gap: 28px">

      <div aria-hidden="true" style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden">
        <label for="f-website">Bitte leer lassen</label><input id="f-website" name="website" tabindex="-1" autocomplete="off">
      </div>
      <input type="hidden" name="t" value="0">

      <fieldset>
        <legend class="big">Sind Sie bereits Kunde?</legend>
        <div class="choices">
          <label class="choice"><input type="radio" name="kundentyp" id="typ-neu" value="Neukunde"><span><b>Nein, ich bin neu</b><small>Projekt, Paket, Kurs oder Workshop</small></span></label>
          <label class="choice"><input type="radio" name="kundentyp" id="typ-bestand" value="Bestandskunde"><span><b>Ja, ich bin Kunde</b><small>Folgeauftrag, Änderung, Organisatorisches</small></span></label>
        </div>
        <p class="hint before-type" style="margin-top: 14px">Danach sehen Sie nur die Fragen, die für Sie passen. Dauert rund 2 Minuten.</p>
      </fieldset>

      <fieldset class="only-neu group">
        <legend>Wofür interessieren Sie sich?</legend>
        <div class="chips">
          {% for p in startseite.pakete.liste %}
          <label class="chip"><input type="radio" name="interesse" value="{{ p.name }}"><span>{{ p.feld }}</span></label>
          {% endfor %}
          <label class="chip"><input type="radio" name="interesse" value="Noch unsicher"><span>Noch unsicher</span></label>
        </div>
        <p class="error" id="err-interesse" role="alert"></p>
      </fieldset>

      <fieldset class="only-bestand group">
        <legend>Worum geht es?</legend>
        <div class="chips">
          {% for t in ["Neues Projekt", "Folgeauftrag", "Änderung an laufendem Projekt", "Organisatorisches"] %}
          <label class="chip"><input type="radio" name="anliegen" value="{{ t }}"><span>{{ t }}</span></label>
          {% endfor %}
        </div>
        <p class="error" id="err-anliegen" role="alert"></p>
      </fieldset>

      <div class="after-type group">
        <div class="grid-2">
          <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" enterkeyhint="next" aria-describedby="err-name"><p class="error" id="err-name"></p></div>
          <div class="field"><label for="f-firma">Unternehmen</label><input id="f-firma" name="unternehmen" autocomplete="organization" enterkeyhint="next" aria-describedby="err-firma"><p class="error" id="err-firma"></p></div>
          <div class="field"><label for="f-mail">E-Mail</label><input id="f-mail" name="email" type="email" inputmode="email" autocomplete="email" enterkeyhint="next" aria-describedby="err-mail"><p class="error" id="err-mail"></p></div>
          <div class="field"><label for="f-tel">Telefon <small>(optional)</small></label><input id="f-tel" name="telefon" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next"></div>
        </div>
      </div>

      <div class="only-neu group">
        <div class="grid-2">
          <div class="field"><label for="f-zeit">Zeitraum</label><select id="f-zeit" name="zeitraum"><option>Flexibel</option><option>In den nächsten 4 Wochen</option><option>In 1–3 Monaten</option><option>Später</option></select></div>
          <div class="field"><label for="f-budget">Budget-Rahmen <small>(optional)</small></label><select id="f-budget" name="budget"><option>Noch offen</option><option>[BUDGETSTUFE 1]</option><option>[BUDGETSTUFE 2]</option><option>[BUDGETSTUFE 3]</option></select><p class="hint">Hilft mir, passende Pakete vorzuschlagen.</p></div>
        </div>
      </div>

      <div class="only-bestand group">
        <div class="grid-2">
          <div class="field"><label for="f-auftrag">Auftragsnummer <small>(optional)</small></label><input id="f-auftrag" name="auftragsnummer" placeholder="A2026048"><p class="hint">Steht auf Ihrem Angebot unter dem Paketnamen.</p></div>
          <fieldset>
            <legend style="margin-bottom: 6px">Wie dringend?</legend>
            <div class="chips">
              {% for t in ["Diese Woche", "Diesen Monat", "Später"] %}
              <label class="chip"><input type="radio" name="dringlichkeit" value="{{ t }}"><span>{{ t }}</span></label>
              {% endfor %}
            </div>
          </fieldset>
        </div>
      </div>

      <div class="after-type group">
        <div class="field"><label for="f-msg">Nachricht</label><textarea id="f-msg" name="nachricht" rows="5" aria-describedby="err-msg" placeholder="Was haben Sie vor? Ziel, Zielgruppe, Ideen."></textarea><p class="error" id="err-msg"></p></div>
        <p class="error" id="err-senden" role="alert"></p>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Anfrage senden</button>
          <span class="hint">Alle Felder sind nötig, außer sie sind als optional markiert.</span>
        </div>
      </div>
    </form>
  </div>

</div>
</div>
