---
layout: base.njk
permalink: /projekte/
title: "Projekte – Referenzen von Bösner Media"
description: "Ausgewählte Projekte von Bösner Media aus Winnenden: Dokumentationen, Kampagnen, Erklärvideos und Social Content für Industrie- und Outdoor-Marken."
---
<section class="section dark" aria-labelledby="projekte-titel" style="padding-top: 96px; padding-bottom: 64px">
  <div class="wrap" style="display: flex; flex-direction: column; gap: 20px; max-width: 1200px">
    <span class="eyebrow">Referenzen</span>
    <h1 id="projekte-titel" class="h-paket">{{ projekte.titel }}<span class="brand">.</span></h1>
    <p class="lead" style="margin: 0">{{ projekte.intro }}</p>
  </div>
</section>

{% for c in projekte.liste %}
<section class="section {{ 'deep dark' if loop.index is odd else 'light' }}" aria-labelledby="case-{{ loop.index }}">
  <div class="wrap split">
    <div class="skew" style="aspect-ratio: 16 / 10; margin: 0 24px">
      <div class="skew-media" style="inset: 16px 40px 16px 28px; background: var(--navy-700)">
        {% if c.video %}<video src="{{ c.video }}" {% if c.bild %}poster="{{ c.bild }}"{% endif %} controls preload="none"></video>{% elif c.bild %}<img src="{{ c.bild }}" alt="{{ c.titel }} {{ c.titel_akzent }}" loading="lazy" style="object-position: center top">{% else %}<span class="placeholder" style="color: #fff">[Video oder Bild]</span>{% endif %}
      </div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 18px">
      <span class="eyebrow plain brand">{{ c.kategorie }}</span>
      <h2 id="case-{{ loop.index }}" class="h-l">{{ c.titel }} <span class="brand">{{ c.titel_akzent }}</span></h2>
      <dl class="meta case-meta">
        <div><dt>Aufgabe</dt><dd>{{ c.aufgabe }}</dd></div>
        <div><dt>Lösung</dt><dd>{{ c.loesung }}</dd></div>
        <div><dt>Ergebnis</dt><dd>{{ c.ergebnis }}</dd></div>
      </dl>
    </div>
  </div>
</section>
{% endfor %}

<section class="academy accent" aria-labelledby="cta-titel">
  <div class="wrap">
    <div style="display: flex; flex-direction: column; gap: 16px; max-width: 640px">
      <span class="eyebrow plain" style="color: #fff">Ihr Projekt</span>
      <h2 id="cta-titel" class="h-display">Das nächste Projekt könnte Ihres sein.</h2>
      <p style="margin: 0; font-weight: 700">Antwort {{ site.antwortzeit }} – versprochen.</p>
    </div>
    <a class="btn btn-primary" href="/kontakt/">Potenzial-Analyse buchen</a>
  </div>
</section>
